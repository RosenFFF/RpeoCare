# Copy to .env.local. All keys stay on the server; never add NEXT_PUBLIC_ to them.
# Public GitHub repositories work without a token, subject to GitHub's anonymous rate limits.
REPOCARE_GITHUB_TOKEN=

# Optional pi-agent content analysis. Provider/model must exist in the installed pi-ai model catalog.
# Run: npm run agent:models -- <provider> to list model IDs. No model calls are made by that command.
REPOCARE_AI_PROVIDER=
REPOCARE_AI_MODEL=
REPOCARE_AI_API_KEY=
# Optional trusted provider endpoint override. Normally leave blank.
REPOCARE_AI_BASE_URL=

# Local persistent database. Keep both web and worker on the same path.
REPOCARE_DB_PATH=data/repocare.sqlite

# Account / deployment. Register this callback in your GitHub OAuth app:
# http://127.0.0.1:3000/api/auth/github/callback (replace origin for production).
REPOCARE_APP_URL=http://127.0.0.1:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set true before exposing the service publicly. Docker Compose enables this.
REPOCARE_REQUIRE_LOGIN=false

# Optional email registration, verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Must remain unchanged for existing encrypted model/GitHub credentials.
# Blank uses data/.model-key. Optional 64-character hex key:
REPOCARE_MASTER_KEY=
REPOCARE_RETENTION_DAYS=90

# Optional isolated bug reproduction. Disabled by default: untrusted repository code
# is never executed on the host. Build the runner first with: npm run repro:image
REPOCARE_REPRO_ENABLED=false
REPOCARE_REPRO_IMAGE=repocare-repro-runner:local
REPOCARE_REPRO_ARTIFACTS=data/reproduction
# Opt in only when a reviewed plan needs package installation. Execution remains network-isolated.
REPOCARE_REPRO_ALLOW_NETWORK=false
REPOCARE_REPRO_MAX_SECONDS=180
