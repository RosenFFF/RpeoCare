{
  "name": "repocare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n web,worker npm:dev:web npm:worker",
    "build": "next build",
    "start": "concurrently --kill-others -n web,worker npm:start:web npm:worker",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx scripts/audit-worker.ts",
    "start:web": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/audit/*.test.ts tests/models/*.test.ts",
    "agent:models": "tsx scripts/agent-models.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@next/env": "16.3.5",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.0",
    "typebox": "^1.3.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
