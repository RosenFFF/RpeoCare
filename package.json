{
  "name": "repocare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n web,audit,repro,agent npm:dev:web npm:worker npm:repro-worker npm:agent-worker",
    "build": "next build",
    "start": "concurrently --kill-others -n web,audit,repro,agent npm:start:web npm:worker npm:repro-worker npm:agent-worker",
    "typecheck": "next typegen && tsc --noEmit",
    "dev:web": "next dev --hostname 127.0.0.1",
    "worker": "tsx scripts/audit-worker.ts",
    "agent-worker": "tsx scripts/agent-worker.ts",
    "start:web": "next start --hostname 127.0.0.1",
    "test": "tsx --test tests/audit/*.test.ts tests/models/*.test.ts tests/workbench/*.test.ts",
    "agent:models": "tsx scripts/agent-models.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "lint": "eslint src scripts tests --quiet",
    "backup": "tsx scripts/backup.ts",
    "cleanup": "tsx scripts/cleanup.ts",
    "test:e2e": "playwright test",
    "repro-worker": "tsx scripts/reproduction-worker.ts",
    "repro:image": "docker build -t repocare-repro-runner:local reproduction"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@next/env": "16.3.5",
    "diff": "9.0.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "oauth4webapi": "^3.8.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1",
    "three": "^0.186.0",
    "typebox": "^1.3.34",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
